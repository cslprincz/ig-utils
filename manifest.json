{
  "manifest_version": 3,
  "name": "IGutils",
  "version": "2.3",
  "description": "Lightweight tool that enhances the Instagram experience",
  "permissions": ["tabs", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["*://*.instagram.com/*"],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}